{
  "name": "each",
  "description": "Startup and SME workspace for finance, accounting, CRM and people, with Thai/English guidance, reviewed AI intake and spreadsheet mirrors.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx --test tests/*.test.ts",
    "test:server": "node --test server/test/*.test.mjs",
    "test:all": "npm run test && npm run test:server",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "product": "npm run build && node server/index.mjs",
    "stack:up": "docker compose up -d",
    "stack:logs": "docker compose logs -f frappe",
    "stack:down": "docker compose down",
    "check:design": "node scripts/check-design.mjs",
    "check:instrument": "node scripts/spatial/verify-manifest.mjs",
    "check:spatial": "node scripts/spatial/prepare-site.mjs && node scripts/spatial/spatial-check.mjs --dir .spatial-site --baseline design/spatial-baseline.json --widths 360,390,414,480,639,640,641,767,768,769,1023,1024,1025,1279,1280,1281,1440,1535,1536,1537,1920 --routes \"/,/?demo=1&module=erp,/?demo=1&module=act,/?demo=1&module=crm,/?demo=1&module=hr,/?demo=1&module=intake,/?demo=1&module=mirrors,/?demo=1&module=security,/?demo=1&module=dossier,/?demo=1&module=design\"",
    "check:spatial:false": "node scripts/spatial/prepare-site.mjs --with-fixture && node scripts/spatial/spatial-falsify.mjs .spatial-site",
    "check:spatial:live": "node scripts/spatial/fetch-deployed.mjs && node scripts/spatial/spatial-check.mjs --dir .spatial-deployed --baseline design/spatial-baseline.json --widths 360,390,414,480,639,640,641,767,768,769,1023,1024,1025,1279,1280,1281,1440,1535,1536,1537,1920 --routes \"/,/?demo=1&module=erp,/?demo=1&module=act,/?demo=1&module=crm,/?demo=1&module=hr,/?demo=1&module=intake,/?demo=1&module=mirrors,/?demo=1&module=security,/?demo=1&module=dossier,/?demo=1&module=design\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/source-sans-3": "^5.2.9",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}

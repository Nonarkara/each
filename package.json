{
  "name": "each",
  "version": "0.3.0",
  "private": true,
  "description": "AXIOM — CRM + ERP + HR + Accounting for the startup",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nonarkara/each.git"
  },
  "homepage": "https://each.nonarkara.org",
  "scripts": {
    "dev": "wrangler pages dev . --compatibility-date=2025-06-27",
    "deploy": "wrangler pages deploy . --branch=main",
    "db:create": "wrangler d1 create axiom-db",
    "db:migrate": "wrangler d1 migrations apply axiom-db",
    "db:migrate:local": "wrangler d1 migrations apply axiom-db --local",
    "db:execute": "wrangler d1 execute axiom-db"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

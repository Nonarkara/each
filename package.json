{
  "name": "each",
  "description": "Startup and SME workspace for finance, accounting, CRM and people, with Thai/English guidance, reviewed AI intake and spreadsheet mirrors.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "stack:up": "docker compose up -d",
    "stack:logs": "docker compose logs -f frappe",
    "stack:down": "docker compose down",
    "check:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/josefin-sans": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.9",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }

# Phase 0 — OAuth (client IDs only; secrets stay on Cloudflare dashboard)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
# GitHub OAuth redirect — must match GitHub App settings
# Example: https://each.nonarkara.org/oauth/github/callback
VITE_GITHUB_REDIRECT_URI=
# Optional override if token exchange runs on a different host
VITE_GITHUB_TOKEN_EXCHANGE_URL=

# Gmail receipt import (separate from sign-in client)
VITE_GOOGLE_REDIRECT_URI=

# Phase 1 — optional live integrations
VITE_COMPANY_LOOKUP_API=
VITE_OCR_API_URL=

# Google Sheets two-way sync (Apps Script Web App URL)
VITE_SHEETS_WEB_APP_URL=

# Phase 2 — Frappe REST backend
# Leave unset for browser-only plug-and-play (npm start).
# Uncomment only after `npm run stack:up` is listening.
# VITE_FRAPPE_URL=http://each.localhost:8000
# Sign in to Frappe at /login first. Never put passwords in VITE_* variables.
# Google verification runs on Frappe; configure each_google_client_id and
# each_axiom_allowed_emails in the server's site_config.json.

# Local Docker defaults. Change these before exposing Frappe beyond your laptop.
EACH_SITE_NAME=each.localhost
EACH_FRAPPE_PORT=8000
EACH_SOCKETIO_PORT=9000
EACH_ADMIN_PASSWORD=admin
EACH_DB_ROOT_PASSWORD=each-local

# Cloudflare Pages Function secrets (set in dashboard — NOT in .env)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
